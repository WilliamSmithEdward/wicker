{
  "name": "wicker",
  "displayName": "Wicker: Symfony & Twig Tooling",
  "description": "Navigate between Symfony controllers and the Twig templates they render.",
  "version": "0.1.0",
  "publisher": "WilliamSmithE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WilliamSmithEdward/wicker.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "symfony",
    "twig",
    "php",
    "template"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/composer.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "twig",
        "aliases": [
          "Twig",
          "twig"
        ],
        "extensions": [
          ".twig"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twig",
        "scopeName": "text.html.twig",
        "path": "./syntaxes/twig.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "html",
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "scopeName": "twig.injection",
        "path": "./syntaxes/twig-injection.tmLanguage.json",
        "injectTo": [
          "text.html.twig"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "wickerTemplate",
        "superType": "type",
        "description": "A Twig template name that Wicker resolved to a file."
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "wickerTemplate": [
            "entity.name.type"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Wicker",
      "properties": {
        "wicker.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Wicker's Symfony and Twig features."
        },
        "wicker.diagnostics.missingTemplate": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "error",
          "description": "How to report a template reference that resolves to no file."
        },
        "wicker.console.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask `bin/console debug:twig` for the Twig namespaces. Bundle namespaces such as `@Twig` are not declared in any configuration file, so without this they cannot be resolved. Never runs in an untrusted workspace."
        },
        "wicker.console.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command that runs the Symfony console, as a list of arguments. Empty means `php bin/console` from the project root. Set this when PHP is not where the editor is, for example `[\"docker\", \"exec\", \"my-php-1\", \"php\", \"bin/console\"]`."
        },
        "wicker.templates.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "File suffixes to index as templates. Leave empty to read `file_name_pattern` from `config/packages/twig.yaml`, falling back to `.twig`."
        },
        "wicker.index.maxFiles": {
          "type": "number",
          "default": 20000,
          "description": "Upper bound on indexed template files per project."
        }
      }
    },
    "commands": [
      {
        "command": "wicker.reindex",
        "title": "Wicker: Rebuild template index"
      },
      {
        "command": "wicker.showProjectInfo",
        "title": "Wicker: Show detected Symfony project"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "npm run compile && vscode-test",
    "vsix": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@wicker/core": "0.1.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^12.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
