# CI tooling only; never bundled into the extension.
#
# requirements.txt is compiled from this file on the CI's Python, 3.12, with
#   pip-compile --allow-unsafe --generate-hashes --strip-extras --output-file=requirements.txt requirements.in
# and Dependabot re-compiles it. pip-tools 7.5 with pip 25 writes a spurious
# --no-index into the header's command line, where it would mean "ignore PyPI"
# to anything that re-runs it, so the header records the command above.
#
# PyJWT override: semgrep 1.178.0 requires pyjwt~=2.13.0, and 2.13.0 has
# advisories fixed only in 2.14.0. Only Semgrep's MCP server imports jwt;
# `semgrep scan` does not. After compiling, replace the pyjwt entry in
# requirements.txt with 2.14.0 and PyPI's hashes for it; the workflow installs
# with --no-deps so pip does not refuse the conflict. A recompile, including a
# Dependabot update, restores 2.13.0 and pip-audit then fails the gate. Remove
# the override when Semgrep allows PyJWT 2.14.0.
semgrep==1.178.0
