{
  "name": "wicker",
  "displayName": "Wicker: Symfony & Twig Tooling",
  "description": "Symfony and Twig navigation, variables, filters, functions and components.",
  "version": "0.4.0",
  "publisher": "WilliamSmithE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WilliamSmithEdward/wicker.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "icon": "icon.png",
  "keywords": [
    "symfony",
    "twig",
    "php",
    "template"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/composer.json"
  ],
  "contributes": {
    "configurationDefaults": {
      "[twig]": {
        "editor.minimap.showRegionSectionHeaders": false
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wicker",
          "title": "Wicker",
          "icon": "resources/wicker-leaf.svg"
        }
      ]
    },
    "views": {
      "wicker": [
        {
          "id": "wicker.projects",
          "name": "Projects",
          "contextualTitle": "Wicker",
          "icon": "resources/wicker-leaf.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "wicker.projects",
        "when": "!config.wicker.enable",
        "contents": "Wicker is disabled. Enable it in settings to browse your projects.\n[Open Wicker Settings](command:wicker.openSettings)"
      },
      {
        "view": "wicker.projects",
        "when": "config.wicker.enable",
        "contents": "Open a Symfony application folder to browse its templates and namespaces.\n[Open Folder](command:vscode.openFolder)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wicker.revealTemplate",
          "when": "view == wicker.projects && config.wicker.enable",
          "group": "navigation@1"
        },
        {
          "command": "wicker.reindex",
          "when": "view == wicker.projects && config.wicker.enable",
          "group": "navigation@2"
        },
        {
          "command": "wicker.openSettings",
          "when": "view == wicker.projects",
          "group": "navigation@3"
        },
        {
          "command": "wicker.showBundleTemplates",
          "when": "view == wicker.projects && config.wicker.enable && !wicker.showBundleTemplates",
          "group": "navigation@4"
        },
        {
          "command": "wicker.hideBundleTemplates",
          "when": "view == wicker.projects && config.wicker.enable && wicker.showBundleTemplates",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "wicker.showProjectInfo",
          "when": "view == wicker.projects && viewItem == wicker.project && config.wicker.enable",
          "group": "diagnostics"
        }
      ],
      "commandPalette": [
        {
          "command": "wicker.showBundleTemplates",
          "when": "!wicker.showBundleTemplates"
        },
        {
          "command": "wicker.hideBundleTemplates",
          "when": "wicker.showBundleTemplates"
        }
      ]
    },
    "languages": [
      {
        "id": "twig",
        "aliases": [
          "Twig",
          "twig"
        ],
        "extensions": [
          ".twig"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twig",
        "scopeName": "text.html.twig",
        "path": "./syntaxes/twig.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "html",
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "scopeName": "twig.injection",
        "path": "./syntaxes/twig-injection.tmLanguage.json",
        "injectTo": [
          "text.html.twig"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "wickerTemplate",
        "superType": "type",
        "description": "A Twig template name that Wicker resolved to a file."
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "wickerTemplate": [
            "entity.name.type"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Wicker",
      "properties": {
        "wicker.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Wicker's Symfony and Twig features."
        },
        "wicker.diagnostics.missingTemplate": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "error",
          "description": "How to report a template reference that resolves to no file."
        },
        "wicker.diagnostics.unknownCallable": {
          "type": "string",
          "enum": ["error", "warning", "information", "off"],
          "default": "warning",
          "description": "How to report unknown Twig filters and functions when fresh, complete project discovery is available."
        },
        "wicker.console.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask `bin/console debug:twig` for Twig namespaces, filters and functions, and `debug:twig-component` for installed Twig Components. Bundle namespaces such as `@Twig` are not declared in any configuration file, so without this they cannot be resolved. Never runs in an untrusted workspace."
        },
        "wicker.console.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command that runs the Symfony console, as a list of arguments. Empty means `php bin/console` from the project root. Set this when PHP is not where the editor is, for example `[\"docker\", \"exec\", \"my-php-1\", \"php\", \"bin/console\"]`."
        },
        "wicker.templates.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "File suffixes to index as templates. Leave empty to read `file_name_pattern` from `config/packages/twig.yaml`, falling back to `.twig`."
        },
        "wicker.index.maxFiles": {
          "type": "number",
          "default": 20000,
          "description": "Upper bound on indexed template files per project."
        }
      }
    },
    "commands": [
      {
        "command": "wicker.reindex",
        "title": "Wicker: Rebuild template index",
        "icon": "$(refresh)"
      },
      {
        "command": "wicker.showProjectInfo",
        "title": "Wicker: Show diagnostics",
        "shortTitle": "Show diagnostics",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.openSettings",
        "title": "Wicker: Open settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "wicker.revealTemplate",
        "title": "Wicker: Reveal current template in sidebar",
        "icon": "$(go-to-file)",
        "enablement": "wicker.canRevealTemplate"
      },
      {
        "command": "wicker.showBundleTemplates",
        "title": "Wicker: Show bundle templates",
        "icon": "$(eye)",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.hideBundleTemplates",
        "title": "Wicker: Hide bundle templates",
        "icon": "$(eye-closed)",
        "enablement": "config.wicker.enable"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "npm run compile && vscode-test",
    "vsix": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@wicker/core": "0.4.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^12.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
