{
  "comments": {
    "blockComment": ["{#", "#}"]
  },
  "brackets": [
    ["{#", "#}"],
    ["{%", "%}"],
    ["{{", "}}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "{#", "close": " #}" },
    { "open": "{%", "close": " %}" },
    { "open": "{{", "close": " }}" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["<", ">"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "<(?!\\?|[^>]*/>)([-_\\.A-Za-z0-9]+)(?=\\s|>)\\b[^>]*>(?!.*</\\1>)|\\{%\\s*(block|embed|filter|for|if|macro|set|spaceless|verbatim|with|apply|autoescape|sandbox)(?!.*end\\1)|\\{#(?!.*#\\})",
    "decreaseIndentPattern": "^\\s*(</[-_\\.A-Za-z0-9]+\\s*>|\\{%\\s*(end(block|embed|filter|for|if|macro|set|spaceless|verbatim|with|apply|autoescape|sandbox)|else|elseif)\\b)"
  }
}
