{
  "name": "wicker",
  "displayName": "Wicker: Symfony & Twig Tooling",
  "description": "Symfony and Twig navigation, variables, filters, functions and components.",
  "version": "0.10.0",
  "publisher": "WilliamSmithE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WilliamSmithEdward/wicker.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "icon": "icon.png",
  "keywords": [
    "symfony",
    "twig",
    "php",
    "template"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/composer.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The Symfony console is not run in an untrusted workspace, so bundle namespaces, routes, Stimulus controllers and components come from configuration files only.",
      "restrictedConfigurations": [
        "wicker.console.command"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The Symfony console cannot run in a virtual workspace, so bundle namespaces, routes, Stimulus controllers and components come from configuration files only."
    }
  },
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/var/**": true
      },
      "[twig]": {
        "editor.minimap.showRegionSectionHeaders": false
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wicker",
          "title": "Wicker",
          "icon": "resources/wicker-leaf.svg"
        }
      ]
    },
    "views": {
      "wicker": [
        {
          "id": "wicker.projects",
          "name": "Projects",
          "contextualTitle": "Wicker",
          "icon": "resources/wicker-leaf.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "wicker.projects",
        "when": "!config.wicker.enable",
        "contents": "Wicker is disabled. Enable it in settings to browse your projects.\n[Open Wicker Settings](command:wicker.openSettings)"
      },
      {
        "view": "wicker.projects",
        "when": "config.wicker.enable",
        "contents": "Open a Symfony application folder to browse its templates and namespaces.\n[Open Folder](command:vscode.openFolder)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wicker.revealTemplate",
          "when": "view == wicker.projects && config.wicker.enable",
          "group": "navigation@1"
        },
        {
          "command": "wicker.reindex",
          "when": "view == wicker.projects && config.wicker.enable",
          "group": "navigation@2"
        },
        {
          "command": "wicker.openSettings",
          "when": "view == wicker.projects",
          "group": "navigation@3"
        },
        {
          "command": "wicker.showBundleTemplates",
          "when": "view == wicker.projects && config.wicker.enable && !wicker.showBundleTemplates",
          "group": "1_display@1"
        },
        {
          "command": "wicker.hideBundleTemplates",
          "when": "view == wicker.projects && config.wicker.enable && wicker.showBundleTemplates",
          "group": "1_display@1"
        },
        {
          "command": "wicker.showProjectInfo",
          "when": "view == wicker.projects && config.wicker.enable",
          "group": "2_help@1"
        }
      ],
      "view/item/context": [
        {
          "command": "wicker.openToSide",
          "when": "view == wicker.projects && viewItem =~ /\\bopens\\b/",
          "group": "navigation@1"
        },
        {
          "command": "wicker.revealInExplorer",
          "when": "view == wicker.projects && viewItem =~ /\\bfile\\b/",
          "group": "navigation@2"
        },
        {
          "command": "wicker.copyTemplateName",
          "when": "view == wicker.projects && viewItem =~ /^wicker\\.(template|controllerTemplate|routeTemplate|extending)\\b/",
          "group": "1_copy@1"
        },
        {
          "command": "wicker.copyRouteName",
          "when": "view == wicker.projects && viewItem =~ /^wicker\\.route\\b|\\brouted\\b/",
          "group": "1_copy@2"
        },
        {
          "command": "wicker.copyRoutePath",
          "when": "view == wicker.projects && viewItem =~ /^wicker\\.route\\b|\\brouted\\b/",
          "group": "1_copy@3"
        },
        {
          "command": "wicker.copyControllerName",
          "when": "view == wicker.projects && viewItem =~ /^wicker\\.(stimulusController|boundController)\\b/",
          "group": "1_copy@4"
        },
        {
          "command": "wicker.showProjectInfo",
          "when": "view == wicker.projects && viewItem =~ /^wicker\\.project\\b/ && config.wicker.enable",
          "group": "diagnostics"
        }
      ],
      "commandPalette": [
        {
          "command": "wicker.showBundleTemplates",
          "when": "!wicker.showBundleTemplates"
        },
        {
          "command": "wicker.hideBundleTemplates",
          "when": "wicker.showBundleTemplates"
        },
        {
          "command": "wicker.openToSide",
          "when": "false"
        },
        {
          "command": "wicker.revealInExplorer",
          "when": "false"
        },
        {
          "command": "wicker.copyTemplateName",
          "when": "false"
        },
        {
          "command": "wicker.copyRouteName",
          "when": "false"
        },
        {
          "command": "wicker.copyRoutePath",
          "when": "false"
        },
        {
          "command": "wicker.copyControllerName",
          "when": "false"
        }
      ]
    },
    "languages": [
      {
        "id": "twig",
        "aliases": [
          "Twig",
          "twig"
        ],
        "extensions": [
          ".twig"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twig",
        "scopeName": "text.html.twig",
        "path": "./syntaxes/twig.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "html",
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "scopeName": "twig.injection",
        "path": "./syntaxes/twig-injection.tmLanguage.json",
        "injectTo": [
          "text.html.twig"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "wickerTemplate",
        "superType": "type",
        "description": "A Twig template name that Wicker resolved to a file."
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "wickerTemplate": [
            "entity.name.type"
          ]
        }
      }
    ],
    "colors": [
      {
        "id": "wicker.stimulusMember",
        "description": "Stimulus members a controller declares: value, target and outlet names.",
        "defaults": {
          "dark": "#4EC9B0",
          "light": "#267F99",
          "highContrast": "#4EC9B0",
          "highContrastLight": "#267F99"
        }
      }
    ],
    "configuration": {
      "title": "Wicker",
      "properties": {
        "wicker.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Wicker's Symfony and Twig features."
        },
        "wicker.diagnostics.missingTemplate": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "error",
          "description": "How to report a template reference that resolves to no file."
        },
        "wicker.diagnostics.unknownCallable": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "description": "How to report unknown Twig filters and functions when fresh, complete project discovery is available."
        },
        "wicker.diagnostics.missingImport": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "markdownDescription": "How to report a JavaScript import the browser cannot resolve: a relative path outside the asset map, one written without its file extension, or a bare specifier declared in no `importmap.php` entry. Each check is suspended when the discovery it depends on is unavailable. The last is also suspended where the project's configuration or PHP names `asset_mapper.importmap.config_reader`: a project that replaces that service can add entries the file never holds."
        },
        "wicker.diagnostics.missingRouteParameter": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "markdownDescription": "How to report a `path()` or `url()` call that names a route the router does not know, or leaves out a placeholder its route requires. A key the route does not declare is not reported: Symfony appends it as a query string. Suspended while the route list is being rebuilt."
        },
        "wicker.diagnostics.unknownBlock": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "markdownDescription": "How to report a top-level `{% block %}` in a template that extends another when no ancestor defines a block of that name, so Twig never renders it. Blocks inside `{% embed %}` are read against the embedded template; a layout named at runtime is not checked."
        },
        "wicker.diagnostics.unknownLiveMember": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "markdownDescription": "How to report, in a Live Component's template, a `data-model` naming no `#[LiveProp]` or one that is not writable, and a `live_action()` or `data-live-action-param` naming no `#[LiveAction]`. Each is refused at runtime without a word. Suspended while the component list is being rebuilt."
        },
        "wicker.sidebar.colors": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Colour sidebar rows by what they are: green for templates, purple for PHP, yellow for JavaScript, blue for TypeScript, cyan for API routes, orange for Stimulus, magenta for stylesheets and red for components. Off draws every icon but a warning in the theme's icon colour."
        },
        "wicker.sidebar.autoReveal": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Select the active editor's template in the sidebar as editors change, the way the Explorer follows the active file. A bundle template is selected only while bundle templates are shown; the Reveal button in the view title shows them regardless."
        },
        "wicker.sidebar.routeHierarchy": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Group the **API routes** and **Template routes** sections by URL path, so `/api/v1/tasks/{id}` sits under api › v1 › tasks and each row is named by its last segment. Off lists every route on one level with its full path."
        },
        "wicker.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what points at a Twig template above its first line: the controller actions that render it, and how many templates extend it. These are the connections the file cannot state about itself; what it extends is on its own first line and already navigates."
        },
        "wicker.console.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask `bin/console debug:twig` for Twig namespaces, filters and functions, and `debug:twig-component` for installed Twig Components. Bundle namespaces such as `@Twig` are not declared in any configuration file, so without this they cannot be resolved. Never runs in an untrusted workspace."
        },
        "wicker.console.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command that runs the Symfony console, as a list of arguments. Empty means `php bin/console` from the project root. Set this when PHP is not where the editor is, for example `[\"docker\", \"exec\", \"my-php-1\", \"php\", \"bin/console\"]`."
        },
        "wicker.templates.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "File suffixes to index as templates. Leave empty to read `file_name_pattern` from `config/packages/twig.yaml`, falling back to `.twig`."
        },
        "wicker.index.maxFiles": {
          "type": "number",
          "default": 20000,
          "description": "Upper bound on indexed template files per project."
        }
      }
    },
    "commands": [
      {
        "command": "wicker.reindex",
        "title": "Wicker: Rebuild template index",
        "icon": "$(refresh)"
      },
      {
        "command": "wicker.showProjectInfo",
        "title": "Wicker: Show diagnostics",
        "shortTitle": "Show diagnostics",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.openSettings",
        "title": "Wicker: Open settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "wicker.revealTemplate",
        "title": "Wicker: Reveal current template in sidebar",
        "icon": "$(go-to-file)",
        "enablement": "wicker.canRevealTemplate"
      },
      {
        "command": "wicker.showBundleTemplates",
        "title": "Wicker: Show bundle templates",
        "icon": "$(eye)",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.hideBundleTemplates",
        "title": "Wicker: Hide bundle templates",
        "icon": "$(eye-closed)",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.goToRoute",
        "title": "Wicker: Go to Route...",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.goToTemplate",
        "title": "Wicker: Go to Template...",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.openToSide",
        "title": "Open to the Side",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.revealInExplorer",
        "title": "Reveal in Explorer View",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.copyTemplateName",
        "title": "Copy Template Name",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.copyRouteName",
        "title": "Copy Route Name",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.copyRoutePath",
        "title": "Copy Route Path",
        "enablement": "config.wicker.enable"
      },
      {
        "command": "wicker.copyControllerName",
        "title": "Copy Controller Identifier",
        "enablement": "config.wicker.enable"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "vscode:prepublish": "node scripts/prepublish.mjs && npm run compile",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "npm run compile && vscode-test",
    "vsix": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@wicker/core": "0.10.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^12.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
